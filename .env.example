# ─────────────────────────────────────────────────────────────────────────
#  RoadNest – környezeti változók
#  Helyi fejlesztéshez másold le .env.local néven és töltsd ki.
#  Vercelen: Project → Settings → Environment Variables.
#  A titkos kulcsokat SOHA ne töltsd fel GitHubra!
# ─────────────────────────────────────────────────────────────────────────

# Az oldal nyilvános címe (canonical URL, OpenGraph, Stripe visszairányítás).
# Élesben pl. https://roadnest.hu – helyben http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (foglalások tárolása) ───────────────────────────────────────
# Supabase irányítópult → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# A "service_role" kulcs vagy az új "secret" kulcs (sb_secret_…). Csak a szerver használja.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (fizetés) ─────────────────────────────────────────────────────
# Stripe irányítópult → Developers → API keys (teszteléshez sk_test_…)
STRIPE_SECRET_KEY=sk_test_
# Stripe irányítópult → Developers → Webhooks → a végpont „Signing secret”-je (whsec_…)
# Helyben: `stripe listen --forward-to localhost:3000/api/stripe/webhook` kiírja.
STRIPE_WEBHOOK_SECRET=whsec_

# ── Resend (e-mailek) ────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_
# Feladó: csak a Resendben ellenőrzött domainről küldhetsz (pl. foglalas@roadnest.hu).
EMAIL_FROM="RoadNest <foglalas@roadnest.hu>"
# Ide érkeznek az új foglalások értesítői (ha üres, a content/camper.ts e-mail-címe).
OWNER_EMAIL=

# ── Ütemezett feladat (napi cron) ────────────────────────────────────────
# Tetszőleges hosszú véletlen szöveg, pl.: openssl rand -hex 32
# A Vercel automatikusan elküldi a cron hívásakor.
CRON_SECRET=
